{
  "name": "q3-interiors",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.functions.json",
    "lint": "oxlint src/ supabase/functions/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "forms:sql": "node scripts/form-sql.ts",
    "db:migrate": "scripts/db-migrate.sh",
    "test:db": "psql \"${DATABASE_URL:-$(pass show env/q3-interiors/DATABASE_URL)}\" -X -q -v ON_ERROR_STOP=1 -o /dev/null -f supabase/tests/access.sql -f supabase/tests/booking.sql -f supabase/tests/changes.sql -c begin -f supabase/forms/published.sql -c rollback && supabase/tests/race.sh && scripts/check-anon-http.sh && echo 'database checks passed'",
    "test:e2e": "playwright test",
    "functions:check": "cd supabase/functions && deno check --config deno.jsonc public-booking/index.ts booking-worker/index.ts calendar-admin/index.ts google-oauth-callback/index.ts",
    "functions:deploy": "scripts/functions-deploy.sh",
    "functions:secrets": "scripts/worker-secrets.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.2",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
